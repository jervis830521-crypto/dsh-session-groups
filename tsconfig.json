{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "rootDir": "src/host",
    "outDir": "lib",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["src/host/**/*.ts"]
}